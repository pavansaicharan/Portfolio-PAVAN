{
  "name": "portfolio-pavan-nayudu",
  "version": "1.0.0",
  "description": "Full-Stack React + Express + Node.js Portfolio for Pavan Sai Charan Nayudu",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "vercel-build": "npm run build --workspace=client",
    "install:all": "npm install",
    "start": "node server/server.js"
  },
  "keywords": [
    "react",
    "express",
    "nodejs",
    "fullstack",
    "portfolio",
    "vercel"
  ],
  "author": "Pavan Sai Charan Nayudu",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
